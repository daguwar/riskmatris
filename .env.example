# Configuration for docker-compose.traefik.yml
# Copy to .env and fill in your values (.env is git-ignored).

# Domain Traefik should route to the container (required), e.g. riskmatris.example.com
RISKMATRIS_DOMAIN=riskmatris.example.com

# Container name. Override when running a second (test) instance on the same
# host from another clone, e.g. RISKMATRIS_CONTAINER_NAME=riskmatris-test
#RISKMATRIS_CONTAINER_NAME=riskmatris

# Name of the Docker network your Traefik runs on (common names: traefik-public,
# traefik_traefik). The network must already exist.
TRAEFIK_NETWORK=traefik-public

# Traefik entrypoint for HTTPS (common: websecure)
TRAEFIK_ENTRYPOINT=websecure

# Name of your Traefik certificate resolver (common: letsencrypt)
TRAEFIK_CERT_RESOLVER=letsencrypt

# ---------------------------------------------------------------------------
# Optional operational settings – all have sensible defaults, see README.md
# ---------------------------------------------------------------------------

# Session retention: sessions are auto-deleted this many hours after last activity.
RISKMATRIS_TTL_HOURS=48

# Log level (INFO) and log format. RISKMATRIS_LOG_FORMAT=json gives one JSON
# object per line – already the default inside the Docker image.
#LOG_LEVEL=INFO
#RISKMATRIS_LOG_FORMAT=json

# Length of generated session codes, 6-16 (default: 8).
#RISKMATRIS_SESSION_CODE_LENGTH=8

# Per-IP rate limit on read endpoints (requests per window) – protects against
# enumeration of session codes (defaults: 300 per 60 seconds).
#RISKMATRIS_SESSION_READ_LIMIT=300
#RISKMATRIS_SESSION_READ_WINDOW_SECONDS=60

# Max sessions created per IP per hour (default: 10).
#RISKMATRIS_SESSION_CREATE_LIMIT=10

# WebSocket connection caps: per session (200), per client IP (20) and
# globally (1000).
#RISKMATRIS_WS_MAX_CONNECTIONS=200
#RISKMATRIS_WS_MAX_CONNECTIONS_PER_IP=20
#RISKMATRIS_WS_MAX_CONNECTIONS_TOTAL=1000

# Max WS messages per connection per window (defaults: 120 per 60 seconds).
#RISKMATRIS_WS_MESSAGE_RATE_LIMIT=120
#RISKMATRIS_WS_MESSAGE_RATE_WINDOW_SECONDS=60

# Set to 1 to expose the interactive API docs (/docs, /redoc, /openapi.json).
# Disabled by default; enabled only in the local docker-compose.yml.
#RISKMATRIS_ENABLE_DOCS=0

# How long SQLite waits for a lock before failing (default: 5000 ms).
# The database runs in WAL mode.
#RISKMATRIS_SQLITE_BUSY_TIMEOUT_MS=5000
