# Konfiguration för docker-compose.traefik.yml
# Kopiera till .env och fyll i dina värden (.env är git-ignorerad).

# Domän som Traefik ska routa till containern (obligatorisk), t.ex. riskmatris.example.com
RISKMATRIS_DOMAIN=riskmatris.example.com

# Namn på Docker-nätverket din Traefik kör på (vanligt: traefik-public)
TRAEFIK_NETWORK=traefik-public

# Traefik entrypoint för HTTPS (vanligt: websecure)
TRAEFIK_ENTRYPOINT=websecure

# Namn på din Traefik certificate resolver (vanligt: letsencrypt)
TRAEFIK_CERT_RESOLVER=letsencrypt
