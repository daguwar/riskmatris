# Configuration for docker-compose.traefik.yml
# Copy to .env and fill in your values (.env is git-ignored).

# Session retention: sessions are auto-deleted this many hours after last
# activity.
# Values below 1 or non-numeric values are rejected at startup with a warning
# and fall back to 48.
RISKMATRIS_TTL_HOURS=48

# Per-IP rate limit for the public read endpoints (session info, WS ticket,
# QR code, CSV export, WebSocket handshake). These are keyed by the session
# code, so without a limit the codes could be enumerated by scripted requests.
# Defaults: 300 requests per 60 seconds per client IP.
RISKMATRIS_SESSION_READ_LIMIT=300
RISKMATRIS_SESSION_READ_WINDOW_SECONDS=60

# Length of generated session codes (allowed range 6-16, default 8).
# 8 characters from the 32-character alphabet = 40 bits of entropy
# (6 characters = only ~30 bits). Still fits the manual join field and QR code.
RISKMATRIS_SESSION_CODE_LENGTH=8

# WebSocket abuse limits (anti DoS/amplification):
# - max simultaneous WS connections per client IP (default 20)
# - max simultaneous WS connections in total across all sessions (default 1000)
# - max WS messages per connection per window (default 120 per 60 seconds)
RISKMATRIS_WS_MAX_CONNECTIONS_PER_IP=20
RISKMATRIS_WS_MAX_CONNECTIONS_TOTAL=1000
RISKMATRIS_WS_MESSAGE_RATE_LIMIT=120
RISKMATRIS_WS_MESSAGE_RATE_WINDOW_SECONDS=60

# Interactive API docs (/docs, /redoc, /openapi.json). Disabled by default
# (secure by default – in production they are a recon aid). Set to 1 only for
# local debugging; the local docker-compose.yml already sets this.
# Accepted values: 1/true/yes/on and 0/false/no/off.
# RISKMATRIS_ENABLE_DOCS=0

# SQLite: how many milliseconds a connection waits for a database lock before
# failing with "database is locked" (default 5000). The database runs in WAL
# mode; this timeout makes concurrent writes wait instead of failing.
RISKMATRIS_SQLITE_BUSY_TIMEOUT_MS=5000

# Domain Traefik should route to the container (required), e.g. riskmatris.example.com
RISKMATRIS_DOMAIN=riskmatris.example.com

# Name of the Docker network your Traefik runs on (common: traefik-public)
TRAEFIK_NETWORK=traefik-public

# Traefik entrypoint for HTTPS (common: websecure)
TRAEFIK_ENTRYPOINT=websecure

# Name of your Traefik certificate resolver (common: letsencrypt)
TRAEFIK_CERT_RESOLVER=letsencrypt
