# Configuration for docker-compose.traefik.yml
# Copy to .env and fill in your values (.env is git-ignored).

# Session retention: sessions are auto-deleted this many hours after last
# activity.
# Values below 1 or non-numeric values are rejected at startup with a warning
# and fall back to 48.
RISKMATRIS_TTL_HOURS=48

# Domain Traefik should route to the container (required), e.g. riskmatris.example.com
RISKMATRIS_DOMAIN=riskmatris.example.com

# Name of the Docker network your Traefik runs on (common: traefik-public)
TRAEFIK_NETWORK=traefik-public

# Traefik entrypoint for HTTPS (common: websecure)
TRAEFIK_ENTRYPOINT=websecure

# Name of your Traefik certificate resolver (common: letsencrypt)
TRAEFIK_CERT_RESOLVER=letsencrypt
