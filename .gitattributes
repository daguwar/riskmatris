# All text files are normalized to LF in the repository and checked out with
# LF everywhere (including on Windows). Avoids "phantom-modified" files
# (git status reports modified but git diff is empty) when the working tree
# is shared between Windows and WSL and files get saved with different line
# endings (CRLF/LF).
* text=auto eol=lf

# Shell scripts and the Dockerfile must keep LF line endings even in Windows
# checkouts, otherwise they break when run inside the Linux container
# (e.g. "/bin/sh^M: bad interpreter").
*.sh text eol=lf
Dockerfile text eol=lf
